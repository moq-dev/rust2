#!/usr/bin/env just --justfile
#
# The driver front end and rust2-lint, invoked from the repo root as `just driver <recipe>`.
# Its own workspace on ts/rust-toolchain.toml's nightly, which the dev shell exports as
# RUST2_TS_TOOLCHAIN; without it, rustup reads the same file through the link here.

set shell := ["bash", "-euo", "pipefail", "-c"]

# mbx's Cargo shim, which the dev shell exports, stays ahead of the nightly so cargo still builds through it.
cargo_shim := if env("RUST2_CARGO_SHIM", "") == "" { "" } else { env("RUST2_CARGO_SHIM") + ":" }
export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { cargo_shim + env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

default:
    @just --list

# Lint and format-check the driver front end, rust2-lint, and its fixtures.
check:
    cargo clippy --locked --all-targets -- -D warnings
    cargo fmt --all --check
    cargo fmt --all --check --manifest-path fixtures/mono/Cargo.toml

# Run rust2-lint on its fixtures.
test *args:
    cargo test --locked {{ args }}

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets
    cargo fmt --all
    cargo fmt --all --manifest-path fixtures/mono/Cargo.toml

# Run rust2-lint: `just driver lint -- test --no-run -p <package>`.
lint *args:
    cargo run --locked --quiet --release -- {{ args }}
