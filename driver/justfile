#!/usr/bin/env just --justfile
#
# The driver front end, invoked from the repo root as `just driver <recipe>`.
# Its own workspace on ts/rust-toolchain.toml's nightly, which the dev shell exports as
# RUST2_TS_TOOLCHAIN; without it, rustup reads the same file through the link here.

set shell := ["bash", "-euo", "pipefail", "-c"]

# mbx's Cargo shim, which the dev shell exports, stays ahead of the nightly so cargo still builds through it.
cargo_shim := if env("RUST2_CARGO_SHIM", "") == "" { "" } else { env("RUST2_CARGO_SHIM") + ":" }
export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { cargo_shim + env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

default:
    @just --list

# Lint and format-check the driver front end and rust2-pub.
check:
    cargo clippy --locked --workspace --all-targets -- -D warnings
    cargo fmt --all --check

# Run the driver front end's and rust2-pub's tests.
test *args:
    cargo test --locked --workspace {{ args }}

# Audit which `pub` items another crate needs, from where it is invoked: `just driver pub --help`.
[no-cd]
pub *args:
    cargo run --quiet --locked --release --manifest-path {{ quote(source_directory() / "Cargo.toml") }} --package rust2-pub -- {{ args }}

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --workspace --all-targets
    cargo fmt --all

