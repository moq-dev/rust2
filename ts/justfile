#!/usr/bin/env just --justfile
#
# The TypeScript driver, invoked from the repo root as `just ts <recipe>`. Its crates
# are their own workspace on ts/rust-toolchain.toml's nightly, which the dev shell
# exports as RUST2_TS_TOOLCHAIN; without it, rustup reads the same file.

set shell := ["bash", "-euo", "pipefail", "-c"]

export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

# The moq revision `moq` translates by default.
moq_rev := "30f25c04e6d0288d87893dc609ba582518be2cf6"

default:
    @just --list

# Lint and format-check the driver, its fixtures, and the bench.
check:
    cargo clippy --locked --all-targets -- -D warnings
    cargo fmt --all --check
    cargo shear
    cargo sort --workspace --check --no-format
    tsc -p runtime
    # The bench against moq's TypeScript at the pin, so a pin that drops what it uses fails here.
    just moq-pin
    cd target/moq && bun install --frozen-lockfile --ignore-scripts --filter @moq/net --silent
    tsc -p bench

# Run the snapshot and differential tests.
test *args:
    cargo test --locked {{ args }}

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets
    cargo fmt --all
    cargo shear --fix
    cargo sort --workspace --no-format

# Run the driver: `just ts run --config <ts.toml> --out <dir>`.
run *args:
    cargo run --locked --quiet -- {{ args }}

# Translate moq-net's codec and type-check it, from the pinned moq revision or a checkout.
moq checkout="":
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ checkout }}"
    if [ -z "$src" ]; then
        just moq-pin
        src=target/moq
    fi
    out=target/moq-ts
    # moq-wasm comes along to select getrandom's wasm backend for moq-net.
    cargo run --locked --quiet -- --config moq/ts.toml --manifest-path "$src/rs/moq-net/Cargo.toml" --out "$out" -- --package moq-wasm
    printf '{ "extends": "%s/runtime/tsconfig.json", "files": [], "include": ["**/*.ts"] }\n' "$PWD" > "$out/tsconfig.json"
    tsc -p "$out"

# Census what translation refuses in moq-net, its model, and kio into target/census, from the pinned moq revision or a checkout.
census checkout="":
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ checkout }}"
    if [ -z "$src" ]; then
        just moq-pin
        src=target/moq
    fi
    cargo run --locked --quiet -- --config moq/net.toml --manifest-path "$src/rs/moq-net/Cargo.toml" --census target/census/moq-net.md -- --package moq-wasm
    cargo run --locked --quiet -- --config moq/model.toml --manifest-path "$src/rs/moq-net/Cargo.toml" --census target/census/model.md -- --package moq-wasm
    cargo run --locked --quiet -- --config moq/kio.toml --manifest-path "$src/rs/kio/Cargo.toml" --census target/census/kio.md

# Check out the pinned moq revision, or another, in target/moq.
[private]
moq-pin rev=moq_rev:
    [ -d target/moq/.git ] || git clone --quiet --filter=blob:none https://github.com/moq-dev/moq target/moq
    # Fetch only a missing pin; the partial clone would otherwise fetch it lazily to look it up.
    GIT_NO_LAZY_FETCH=1 git -C target/moq cat-file -e {{ rev }}^{commit} 2> /dev/null || git -C target/moq fetch --quiet --depth 1 origin {{ rev }}
    git -C target/moq checkout --quiet --detach {{ rev }}

# Time the codec natively, as moq's WASM, as moq's hand-written TS, and translated, in Node, Bun, Chrome, and Firefox; `--route name=dir` adds another run's translations.
[arg("route", long)]
bench checkout="" route="": (moq checkout)
    #!/usr/bin/env bash
    set -euo pipefail
    for tool in bun chromium firefox wasm-bindgen; do
        command -v "$tool" > /dev/null || { echo "$tool is missing: run this in the bench shell, nix develop .#bench" >&2; exit 1; }
    done
    src="{{ checkout }}"
    [ -n "$src" ] || src=target/moq
    route=()
    [ -z "{{ route }}" ] || route=(--route "{{ route }}")
    out=target/bench
    cargo run --locked --quiet -- --config fixtures/codec/ts.toml --out "$out/translated"
    cargo build --locked --quiet --package codec-fixture --features bench --target wasm32-unknown-unknown --profile wasm-release
    cargo build --locked --quiet --package codec-fixture --example bench --release
    cargo run --locked --quiet -- --config fixtures/task/ts.toml --out "$out/task"
    cargo build --locked --quiet --package task-fixture --features bench --target wasm32-unknown-unknown --profile wasm-release
    cargo build --locked --quiet --package task-fixture --example handoff --release
    # moq's hand-written TS imports its npm dependencies; its postinstall builds libav.
    (cd "$src" && bun install --frozen-lockfile --ignore-scripts --filter @moq/net)
    # moq-wasm's package, as moq's `just js wasm` builds it.
    (cd "$src" && cargo build --locked --quiet --package moq-wasm --target wasm32-unknown-unknown --profile wasm-release)
    wasm-bindgen --target web --out-name moq --out-dir "$out/moq-wasm" "$src/target/wasm32-unknown-unknown/wasm-release/moq_wasm.wasm"
    bun bench/main.ts --translated "$out/translated" --moq "$src" --moq-wasm "$out/moq-wasm" --out "$out" \
        --wasm target/wasm32-unknown-unknown/wasm-release/codec_fixture.wasm --native target/release/examples/bench \
        --task "$out/task" \
        --task-wasm target/wasm32-unknown-unknown/wasm-release/task_fixture.wasm --task-native target/release/examples/handoff \
        "${route[@]}"

# Run cargo on the pinned nightly.
cargo *args:
    cargo {{ args }}
