#!/usr/bin/env just --justfile
#
# The Go translator, invoked from the repo root as `just go <recipe>`. Its crates are
# their own workspace on ts/rust-toolchain.toml's nightly, which the dev shell exports as
# RUST2_TS_TOOLCHAIN; without it, rustup reads the same file through the link here.

set shell := ["bash", "-euo", "pipefail", "-c"]

export PATH := if env("RUST2_TS_TOOLCHAIN", "") == "" { env("PATH") } else { env("RUST2_TS_TOOLCHAIN") / "bin:" + env("PATH") }

default:
    @just --list

# Lint and format-check the translator, its fixtures, and its runtime.
check:
    cargo clippy --locked --all-targets -- -D warnings
    cargo fmt --all --check
    cargo shear
    cargo sort --workspace --check --no-format
    test -z "$(gofmt -l runtime tests bench)"
    cd runtime && go vet rt.go rt_fmt.go

# Run the differential and refusal tests.
test *args:
    cargo test --locked {{ args }}

# Apply formatters without changing program behavior.
fix:
    cargo clippy --locked --fix --allow-staged --allow-dirty --all-targets
    cargo fmt --all
    cargo shear --fix
    cargo sort --workspace --no-format
    gofmt -w runtime tests bench

# Run the translator: `just go run --config <go.toml> --out <dir>`.
run *args:
    cargo run --locked --quiet -- {{ args }}

# Time the codec translated to Go against its C ABI through cgo, as rust2-ffi exports it, both without overflow checks as a release build has none.
bench *args:
    #!/usr/bin/env bash
    set -euo pipefail
    out="$PWD/target/bench"
    cargo run --locked --quiet -- --config fixtures/codec/go.toml --manifest-path fixtures/codec/Cargo.toml --out "$out/codec" \
        -- --config profile.dev.overflow-checks=false
    printf 'module codec\n\ngo 1.24\n' > "$out/codec/go.mod"
    cargo run --locked --quiet --manifest-path ../ffi/Cargo.toml -- --config bench/ffi.toml --manifest-path fixtures/codec/Cargo.toml --out "$out/ffi"
    cargo build --quiet --release --manifest-path "$out/ffi/Cargo.toml" --target-dir "$out/ffi/target"
    cd bench
    CGO_CFLAGS="-I$out/ffi/include" CGO_LDFLAGS="$out/ffi/target/release/libcodec.a" go test -count=1 -run Agree -bench . -benchtime 1s {{ args }}
